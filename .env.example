# Connection string do Postgres do Supabase (Project Settings → Database → Connection string).
# Na Vercel, use a do pooler em modo "Transaction" (porta 6543).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# URL pública do site (usada nos links de compartilhar e nas prévias). Opcional na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: tamanho do pool de conexões (padrão 5).
# DATABASE_POOL_MAX=5
